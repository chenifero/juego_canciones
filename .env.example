# Spotify (developer.spotify.com/dashboard → tu app → Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la Redirect URI de la app de Spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
# País del catálogo de Spotify
SPOTIFY_MARKET=ES

# PIN del panel de la dueña. En desarrollo sirve cualquiera (1234 por defecto);
# en producción (Fly) hacen falta de 6 a 12 cifras y no vale algo evidente como 123456.
# Tras 3 fallos seguidos, cada IP espera cada vez más antes de poder probar otra vez.
ADMIN_PIN=1234

# Dónde vive la web (en desarrollo, Vite)
WEB_ORIGIN=http://127.0.0.1:5173

# 1 = simulador de Spotify (canciones falsas y cortas, sin cuenta). 0 = Spotify real
MOCK_SPOTIFY=0
